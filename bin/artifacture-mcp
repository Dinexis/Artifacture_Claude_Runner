#!/usr/bin/env bash
# Minimaler MCP-Client (Streamable HTTP) für den Artifacture-MCP.
# Aufruf: artifacture-mcp <toolname>
# Gibt das Tool-Ergebnis als JSON auf stdout aus (structuredContent bzw. geparster Text).
set -euo pipefail

tool="${1:?Toolname fehlt}"
URL="${ARTIFACTURE_MCP_URL:-https://artifacture.ai/mcp}"
: "${ARTIFACTURE_PROJECT_TOKEN:?ARTIFACTURE_PROJECT_TOKEN fehlt}"
PV="2025-06-18"
hdrs="$(mktemp)"; trap 'rm -f "$hdrs"' EXIT

rpc() { # $1 = JSON-Body, $2 = Mcp-Session-Id (optional)
  local extra=()
  [ -n "${2:-}" ] && extra=(-H "Mcp-Session-Id: $2")
  curl -sS --fail-with-body -D "$hdrs" -X POST "$URL" \
    -H "Authorization: Bearer ${ARTIFACTURE_PROJECT_TOKEN}" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -H "MCP-Protocol-Version: ${PV}" \
    "${extra[@]}" \
    --data "$1"
}

# Antwort kann JSON oder SSE sein -> JSON-RPC-Response extrahieren
extract() {
  local body; body="$(cat)"
  if printf '%s\n' "$body" | grep -q '^data:'; then
    printf '%s\n' "$body" | sed -n 's/^data: \{0,1\}//p' | jq -s 'map(select(.id != null)) | last'
  else
    printf '%s' "$body"
  fi
}

init="$(jq -nc --arg pv "$PV" '{jsonrpc:"2.0", id:1, method:"initialize",
  params:{protocolVersion:$pv, capabilities:{}, clientInfo:{name:"claude-runner-checkout", version:"1.0"}}}')"
rpc "$init" | extract >/dev/null
sid="$(grep -i '^mcp-session-id:' "$hdrs" | head -n1 | cut -d: -f2- | tr -d ' \r' || true)"

rpc '{"jsonrpc":"2.0","method":"notifications/initialized"}' "$sid" >/dev/null

# Kein projectId: der Projekt-Token legt das Projekt fest und autorisiert zugleich.
call="$(jq -nc --arg t "$tool" '{jsonrpc:"2.0", id:2, method:"tools/call",
  params:{name:$t, arguments:{}}}')"
resp="$(rpc "$call" "$sid" | extract)"

if printf '%s' "$resp" | jq -e '.error // (.result.isError == true)' >/dev/null; then
  echo "MCP-Fehler bei $tool: $(printf '%s' "$resp" | jq -c '.error // .result.content')" >&2
  exit 1
fi

printf '%s' "$resp" | jq -ce '.result.structuredContent // (.result.content[0].text | fromjson)'
