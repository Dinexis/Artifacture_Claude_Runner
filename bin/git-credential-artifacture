#!/bin/sh
# Git-Credential-Helper: holt pro Aufruf ein kurzlebiges Token von Artifacture (ADR-039 §12).
# Das Token ist auf die Repos des Projekts begrenzt, laeuft nach einer Stunde ab und wird nirgends
# abgelegt — jede Git-Operation fragt neu. store/erase werden deshalb ignoriert.
[ "$1" = "get" ] || exit 0
host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0
[ -n "${ARTIFACTURE_PROJECT_TOKEN:-}" ] || exit 1
api="${ARTIFACTURE_API_URL:-https://artifacture.ai}"
# Header ueber stdin statt argv, damit das Projekt-Token nicht in `ps` steht.
response="$(printf 'header = "Authorization: Bearer %s"\n' "$ARTIFACTURE_PROJECT_TOKEN" \
  | curl -fsS --config - "${api%/}/api/runner/git-credential")" || exit 1
token="$(printf '%s' "$response" | jq -er .token)" || exit 1
printf 'username=x-access-token\npassword=%s\n' "$token"
