#!/bin/sh
# Git-Credential-Helper: liefert ARTIFACTURE_GIT_TOKEN für github.com (Clone und Push).
[ "$1" = "get" ] || exit 0
host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0
[ -n "${ARTIFACTURE_GIT_TOKEN:-}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$ARTIFACTURE_GIT_TOKEN"
